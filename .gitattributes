# Скрипты Windows храним байт-в-байт с CRLF (иначе cmd.exe ломает разбор)
*.bat -text
*.cmd -text

# Исходники и документация — LF
*.java text eol=lf
*.md text eol=lf

# Бинарники не трогаем
*.jar binary
*.class binary
*.dll binary
*.exe binary
*.lib binary
*.zip binary
*.db binary

# Рантайм Java — как есть
portable/runtime/** -text
